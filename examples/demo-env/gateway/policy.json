{
  "version": 1,
  "mode": "enforce",
  "default": "allow",
  "rules": [
    {"name": "no deletes", "tool": "delete_*", "action": "deny", "reason": "destructive tools are denied"},
    {"name": "read-only SQL", "tool": "query", "args": {"sql": {"not_match": "(?i)\\b(drop|delete|truncate|update|insert|alter)\\b"}}, "action": "allow"},
    {"name": "block SQL writes", "tool": "query", "action": "deny", "reason": "only read-only SQL is allowed"},
    {"name": "support-bot refunds ACME orders only", "agent": "support-bot", "tool": "refund_order", "args": {"order_id": {"prefix": "ACME-"}}, "action": "allow"},
    {"name": "no other refunds", "tool": "refund_order", "action": "deny", "reason": "refunds are limited to ACME orders"},
    {"name": "humans approve outbound email", "tool": "send_email", "action": "approve", "reason": "outbound email needs a human"}
  ],
  "rate_limits": [{"tool": "*", "per_minute": 60}],
  "kill_switch_file": "/tmp/groot.kill",
  "tool_checks": {"hide_denied": true, "flag_injection": true, "hide_flagged": true, "alert_on_change": true, "block_changed_tools": true}
}
