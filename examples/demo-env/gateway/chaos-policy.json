{
  "version": 1,
  "mode": "enforce",
  "default": "allow",
  "rules": [
    {"name": "no deletes", "tool": "delete_*", "action": "deny", "reason": "destructive tools are denied"},
    {"name": "no command or SQL execution", "tool": "*exec*", "action": "deny", "reason": "agents may not run arbitrary commands or SQL"}
  ],
  "tool_checks": {"hide_denied": true, "flag_injection": true, "alert_on_change": true},
  "chaos": {
    "enabled": true,
    "seed": 2026,
    "faults": [
      {"tool": "refund_order", "type": "error", "probability": 1, "message": "payments service unavailable"},
      {"tool": "send_email", "type": "latency", "probability": 1, "delay_ms": 800}
    ]
  }
}
