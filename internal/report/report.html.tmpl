<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>
.viz-root {
  color-scheme: light;
  --surface-0: #f4f4f2; --surface-1: #fcfcfb; --border: #e2e1dc;
  --text-primary: #0b0b0b; --text-secondary: #52514e; --text-muted: #77766f;
  --good: #0ca30c; --warning: #fab219; --serious: #ec835a; --critical: #d03b3b; --neutral: #9a9992;
  --kind-agent: #2a78d6; --kind-mcp: #eb6834; --kind-sa: #1baf7a; --kind-role: #6250d6;
  --edge: #b9b8b1;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) .viz-root {
    color-scheme: dark;
    --surface-0: #121211; --surface-1: #1a1a19; --border: #33332f;
    --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #9a998f;
    --kind-agent: #3987e5; --kind-mcp: #d95926; --kind-sa: #199e70; --kind-role: #9085e9;
    --edge: #55554f;
  }
}
:root[data-theme="dark"] .viz-root {
  color-scheme: dark;
  --surface-0: #121211; --surface-1: #1a1a19; --border: #33332f;
  --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #9a998f;
  --kind-agent: #3987e5; --kind-mcp: #d95926; --kind-sa: #199e70; --kind-role: #9085e9;
  --edge: #55554f;
}
* { box-sizing: border-box; }
body { margin: 0; }
.viz-root { background: var(--surface-0); color: var(--text-primary); min-height: 100vh;
  font: 14px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 1180px; margin: 0 auto; padding: 32px 24px 64px; }
header h1 { font-size: 24px; margin: 0 0 4px; letter-spacing: -0.01em; }
header p { margin: 0; color: var(--text-secondary); }
h2 { font-size: 18px; margin: 40px 0 12px; }
h3 { font-size: 16px; margin: 0; }
nav { display: flex; gap: 16px; margin: 16px 0 0; font-size: 13px; }
nav a { color: var(--text-secondary); text-decoration: none; border-bottom: 1px solid var(--border); }
code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; }
.muted { color: var(--text-muted); }
.secondary { color: var(--text-secondary); }

.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-top: 24px; }
.tile { background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
.tile .label { color: var(--text-secondary); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
.tile .value { font-size: 30px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.2; margin-top: 4px; }
.tile .sub { color: var(--text-muted); font-size: 12px; }
.tile .bar { height: 4px; border-radius: 2px; margin-top: 10px; background: var(--border); display: flex; gap: 2px; overflow: hidden; }
.tile .bar span { display: block; height: 100%; }

.card { background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; margin-bottom: 12px; }
.card-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.card-head .meta { margin-left: auto; color: var(--text-muted); font-size: 12px; }
.badge { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 600; text-transform: uppercase;
  letter-spacing: .04em; padding: 2px 8px 2px 6px; border-radius: 999px; border: 1px solid var(--border); color: var(--text-primary); white-space: nowrap; }
.badge::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--dot, var(--neutral)); }
.st-pass, .ok { --dot: var(--good); }
.st-fail, .sev-critical { --dot: var(--critical); }
.st-inconclusive, .sev-medium { --dot: var(--warning); }
.st-error, .sev-high { --dot: var(--serious); }
.sev-low { --dot: var(--neutral); }
.kind { color: var(--text-secondary); font-size: 12px; }

ul.checks { list-style: none; padding: 0; margin: 10px 0 0; }
ul.checks li { display: grid; grid-template-columns: 18px 1fr; gap: 6px; padding: 3px 0; }
.mark-pass { color: var(--good); font-weight: 700; }
.mark-fail { color: var(--critical); font-weight: 700; }
.detail { color: var(--text-secondary); }
.callout { border-left: 3px solid var(--dot, var(--neutral)); background: var(--surface-0); border-radius: 0 6px 6px 0; padding: 8px 12px; margin-top: 10px; }
.callout p { margin: 0 0 4px; }
.path { color: var(--text-secondary); font-size: 12.5px; }
.footer-line { color: var(--text-muted); font-size: 12px; margin-top: 10px; }

.answers { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 8px; margin: 14px 0; }
.answer { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--surface-0); }
.answer .q { font-size: 13px; }
.answer .a { font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 6px; }
.answer .ev { color: var(--text-muted); font-size: 12px; margin-top: 2px; overflow-wrap: anywhere; }
.yes .a { color: var(--text-primary); }
.yes { border-color: color-mix(in srgb, var(--critical) 45%, var(--border)); }
.no .a { color: var(--text-secondary); }
.icon-yes { color: var(--critical); } .icon-no { color: var(--good); }

.graph-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-0); margin: 12px 0; }
.legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: var(--text-secondary); margin-top: 6px; }
.legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 5px; vertical-align: -1px; border: 2px solid var(--c); }
svg.reach text { font: 12px ui-sans-serif, system-ui, sans-serif; fill: var(--text-primary); }
svg.reach .edge { fill: none; stroke: var(--edge); stroke-width: 2; }
svg.reach .edge.cap { stroke-dasharray: 3 3; stroke-width: 1.5; }
svg.reach .node rect { stroke-width: 2; stroke: var(--c); fill: color-mix(in srgb, var(--c) 12%, var(--surface-1)); }
svg.reach .kind-agent { --c: var(--kind-agent); }
svg.reach .kind-mcp_server { --c: var(--kind-mcp); }
svg.reach .kind-service_account { --c: var(--kind-sa); }
svg.reach .kind-aws_role { --c: var(--kind-role); }
svg.reach .chip rect { fill: var(--surface-1); stroke: var(--dot); stroke-width: 2; }
svg.reach .chip.sev-critical { --dot: var(--critical); }
svg.reach .chip.sev-high { --dot: var(--serious); }
svg.reach .chip.sev-medium { --dot: var(--warning); }
svg.reach .chip.sev-low { --dot: var(--neutral); }
svg.reach g:hover rect { stroke-width: 3; }
svg.reach .edge:hover { stroke: var(--text-secondary); }

table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
th { color: var(--text-secondary); font-weight: 600; font-size: 12px; }
details { margin-top: 10px; }
summary { cursor: pointer; color: var(--text-secondary); font-size: 13px; }
.finding { padding: 10px 0; border-top: 1px solid var(--border); }
.finding:first-child { border-top: 0; }
.finding .title { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
.fix { color: var(--text-secondary); font-size: 13px; margin-top: 4px; }
.fix b { color: var(--text-primary); font-weight: 600; }
.notes li { color: var(--text-secondary); }
</style>
</head>
<body>
<div class="viz-root">
<main>
<header>
  <h1>{{.Title}}</h1>
  <p>Generated {{.Generated.Format "2006-01-02 15:04 MST"}}{{with .Test}} · agent <b>{{.Agent}}</b>{{end}}</p>
  <nav>{{if .Test}}<a href="#tests">Tests</a>{{end}}{{if .Scan}}<a href="#reach">What agents can reach</a><a href="#findings">Findings</a>{{end}}</nav>
</header>

<section class="tiles" aria-label="Summary">
{{- with .Test}}{{$c := testCounts .}}{{$n := len .Results}}
  <div class="tile"><div class="label">Scenarios</div><div class="value">{{$n}}</div>
    <div class="sub">{{index $c "pass"}} passed · {{index $c "fail"}} failed{{with index $c "inconclusive"}} · {{.}} inconclusive{{end}}{{with index $c "error"}} · {{.}} errors{{end}}</div>
    <div class="bar" role="img" aria-label="{{index $c "pass"}} passed, {{index $c "fail"}} failed">
      {{- if index $c "fail"}}<span style="flex: {{index $c "fail"}}; background: var(--critical)"></span>{{end}}
      {{- if index $c "error"}}<span style="flex: {{index $c "error"}}; background: var(--serious)"></span>{{end}}
      {{- if index $c "inconclusive"}}<span style="flex: {{index $c "inconclusive"}}; background: var(--warning)"></span>{{end}}
      {{- if index $c "pass"}}<span style="flex: {{index $c "pass"}}; background: var(--good)"></span>{{end}}</div></div>
  <div class="tile"><div class="label">Failed</div><div class="value">{{index $c "fail"}}</div><div class="sub">unsafe behaviour under attack or failure</div></div>
{{- end}}
{{- with .Scan}}{{$s := sevCounts .}}
  <div class="tile"><div class="label">Agents scanned</div><div class="value">{{len .Agents}}</div><div class="sub">{{len .Findings}} findings</div></div>
  <div class="tile"><div class="label">Critical findings</div><div class="value">{{index $s "critical"}}</div>
    <div class="sub">{{index $s "high"}} high · {{index $s "medium"}} medium · {{index $s "low"}} low</div>
    <div class="bar" role="img" aria-label="findings by severity">
      {{- if index $s "critical"}}<span style="flex: {{index $s "critical"}}; background: var(--critical)"></span>{{end}}
      {{- if index $s "high"}}<span style="flex: {{index $s "high"}}; background: var(--serious)"></span>{{end}}
      {{- if index $s "medium"}}<span style="flex: {{index $s "medium"}}; background: var(--warning)"></span>{{end}}
      {{- if index $s "low"}}<span style="flex: {{index $s "low"}}; background: var(--neutral)"></span>{{end}}</div></div>
{{- end}}
</section>

{{with .Test}}
<h2 id="tests">Tests under attack and failure</h2>
{{range .Results}}
<article class="card">
  <div class="card-head">
    <span class="badge st-{{.Status}}">{{.Status}}</span>
    <h3>{{.Scenario}}</h3>
    <span class="kind">{{.Kind}}</span>
    <span class="meta">{{secs .DurationMs}} · {{.Summary.Calls}} tool calls · {{.Summary.Blocked}} blocked · {{.Summary.Faults}} faults{{if .Summary.LLMCalls}} · {{.Summary.LLMCalls}} model calls (${{printf "%.4f" .Summary.CostUSD}}){{end}}</span>
  </div>
  {{with .Description}}<div class="secondary">{{.}}</div>{{end}}
  {{with .Error}}<div class="callout st-error"><p><b>Could not run:</b> {{.}}</p></div>{{end}}
  {{if .Checks}}<ul class="checks">
  {{range .Checks}}<li>{{if .Pass}}<span class="mark-pass" aria-label="pass">✓</span>{{else}}<span class="mark-fail" aria-label="fail">✗</span>{{end}}
    <span>{{.Name}}{{with .Detail}} <span class="detail">— {{.}}</span>{{end}}</span></li>{{end}}
  </ul>{{end}}
  {{with .Differential}}<div class="callout {{if eq .Outcome "only under failure"}}sev-critical{{else}}sev-low{{end}}">
    <p><b>Control run: {{.Outcome}}.</b> {{.Summary}}</p></div>{{end}}
  {{with .Impact}}<div class="callout sev-{{.Severity}}">
    <p><span class="badge sev-{{.Severity}}">impact {{.Severity}}</span> <b>{{.Agent}}</b> {{if .Contained}}tried to obey{{else}}obeyed{{end}} an injected instruction through <code>{{join .Obeyed ", "}}</code>.{{if .Contained}} Policy blocked the call, but the agent's identity still holds this reach:{{else}} Its identity can reach:{{end}}</p>
    {{range .Reach}}<p><span class="badge sev-{{.Severity}}">{{.Severity}}</span> <span class="mono">{{.Rule}}</span> {{.Detail}}{{with .Path}}<br><span class="path">{{join . " → "}}</span>{{end}}</p>{{end}}
    {{with .Note}}<p class="muted">{{.}}</p>{{end}}
  </div>{{end}}
  <div class="footer-line">Evidence: <code>{{.Dir}}</code></div>
</article>
{{end}}
{{end}}

{{with .Scan}}{{$scan := .}}
<h2 id="reach">What each agent can reach</h2>
<p class="secondary">Every path from the agent to an identity or MCP server, and what each one lets it do. Hover a box or line for details.</p>
<div class="legend">
  <span><i style="--c: var(--kind-agent)"></i>agent</span><span><i style="--c: var(--kind-sa)"></i>Kubernetes service account</span>
  <span><i style="--c: var(--kind-role)"></i>AWS role</span><span><i style="--c: var(--kind-mcp)"></i>MCP server</span>
  <span class="badge sev-critical">critical</span><span class="badge sev-high">high</span><span class="badge sev-medium">medium</span><span class="badge sev-low">low</span>
</div>
{{range .Agents}}
<article class="card" id="agent-{{.Name}}">
  <div class="card-head"><h3>{{.Name}}</h3><span class="kind">{{join .Sources " · "}}</span>
    <span class="meta">{{yesCount .Answers}} of {{len .Answers}} dangerous capabilities</span></div>
  <div class="answers">
  {{range .Answers}}<div class="answer {{if .Yes}}yes{{else}}no{{end}}">
    <div class="q">{{.Question}}</div>
    <div class="a">{{if .Yes}}<span class="icon-yes" aria-hidden="true">●</span>Yes{{if .Prod}}, including production{{end}}{{else}}<span class="icon-no" aria-hidden="true">○</span>No{{end}}</div>
    {{if .Yes}}<div class="ev">{{index .Evidence 0}}{{with .Via}} · via {{.}}{{end}}</div>{{end}}
  </div>{{end}}
  </div>
  {{if .Reach}}<div class="graph-wrap">{{svg $scan .}}</div>{{else}}<p class="muted">No identities or servers resolved for this agent.</p>{{end}}
  {{with .Grants}}<details><summary>All {{len .}} permissions as a table</summary>
    <table><thead><tr><th>Class</th><th>Permission</th><th>Via</th><th>Source</th></tr></thead><tbody>
    {{range .}}<tr><td>{{.Class}}</td><td class="mono">{{.Text}}{{if .Conditional}} <span class="muted">(conditional)</span>{{end}}</td><td>{{.Via}}</td><td>{{.Source}}{{if .Prod}} · prod{{end}}</td></tr>{{end}}
    </tbody></table></details>{{end}}
</article>
{{end}}

<h2 id="findings">Findings</h2>
{{range .Agents}}{{$fs := findings $scan .Name}}{{if $fs}}
<article class="card">
  <h3>{{.Name}}</h3>
  {{range $fs}}<div class="finding">
    <div class="title"><span class="badge sev-{{sev .Severity}}">{{sev .Severity}}</span><span class="mono">{{.Rule}}</span><b>{{.Title}}</b>{{if .Conditional}}<span class="muted">conditional</span>{{end}}</div>
    <div>{{.Detail}}</div>
    {{with .Path}}<div class="path">{{join . " → "}}</div>{{end}}
    {{with .Evidence}}<div class="path mono">{{join . " · "}}</div>{{end}}
    <div class="fix"><b>Fix:</b> {{.Fix}}</div>
  </div>{{end}}
</article>
{{end}}{{end}}
{{with .Notes}}<ul class="notes">{{range .}}<li>{{.}}</li>{{end}}</ul>{{end}}
{{end}}
</main>
</div>
</body>
</html>
